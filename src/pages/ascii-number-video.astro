---
import BaseLayout from '../layouts/BaseLayout.astro';

const generatorScriptPath = 'scripts/generate_ascii_number_video.py';
const serverScriptPath = 'scripts/ascii_number_video_server.py';
const defaultServerUrl = 'http://127.0.0.1:8765';
---

<BaseLayout title="ASCII Number Video | GeeBee Forge">
  <main class="ascii-page">
    <section class="hero" aria-labelledby="page-title">
      <div class="hero-copy">
        <span class="eyebrow">Local Forge Tool</span>
        <h1 id="page-title">ASCII Number Video</h1>
        <p>
          Trigger a local render from this page, then preview and download the MP4.
          The static site talks to a companion server running on your machine.
        </p>
      </div>

      <div class="preview-shell" aria-label="Animated preview of ASCII number style">
        <canvas id="ascii-preview" width="960" height="540"></canvas>
      </div>
    </section>

    <section class="forge-bench" aria-label="ASCII number video local renderer">
      <form id="render-form" class="render-panel" aria-label="Generate ASCII number video">
        <div>
          <span class="panel-kicker">Local Renderer</span>
          <h2>Generate MP4</h2>
        </div>

        <div class="field-grid">
          <label>
            <span>Width</span>
            <input id="width-input" type="number" min="320" max="7680" step="2" value="1080" inputmode="numeric" />
          </label>

          <label>
            <span>Height</span>
            <input id="height-input" type="number" min="180" max="4320" step="2" value="1920" inputmode="numeric" />
          </label>
        </div>

        <label>
          <span>Companion server</span>
          <input id="server-url-input" type="url" value={defaultServerUrl} inputmode="url" spellcheck="false" />
        </label>

        <div class="action-row">
          <button id="generate-button" class="primary-button" type="submit">Generate</button>
          <button id="refresh-button" class="copy-button" type="button">Refresh Status</button>
        </div>

        <p class="helper-text">
          Start the local server first. The site remains static; Python, edge-tts,
          ffmpeg, and ffprobe run only on your machine.
        </p>
      </form>

      <section class="status-panel" aria-label="Render status">
        <div class="panel-heading">
          <div>
            <span class="panel-kicker">Render Status</span>
            <h2 id="status-heading">Not Connected</h2>
          </div>
          <span id="status-pill" class="status-pill">Idle</span>
        </div>

        <div class="progress-track" aria-label="Render progress">
          <div id="progress-bar" class="progress-bar"></div>
        </div>

        <p id="status-text" class="status-text">
          Start <code>{serverScriptPath}</code>, then generate a video from this page.
        </p>

        <pre class="log-box" aria-label="Render log"><code id="log-text">No render log yet.</code></pre>
      </section>

      <section id="result-panel" class="result-panel" aria-label="Generated video preview" hidden>
        <div class="panel-heading">
          <div>
            <span class="panel-kicker">Preview</span>
            <h2>Generated Video</h2>
          </div>
          <a id="download-link" class="download-button" href={defaultServerUrl} download>Download MP4</a>
        </div>

        <video id="result-video" controls playsinline preload="metadata"></video>
      </section>

      <section class="command-panel" aria-label="Local commands">
        <div class="panel-heading">
          <div>
            <span class="panel-kicker">Exact Local Commands</span>
            <h2>Start Server or Render Directly</h2>
          </div>
        </div>

        <div class="command-block">
          <div class="command-heading">
            <span>Companion server</span>
            <button class="copy-button compact" type="button" data-copy-target="server-command-text">Copy</button>
          </div>
          <pre><code id="server-command-text">python3 {serverScriptPath}</code></pre>
        </div>

        <div class="command-block">
          <div class="command-heading">
            <span>Direct render fallback</span>
            <button class="copy-button compact" type="button" data-copy-target="command-text">Copy</button>
          </div>
          <pre><code id="command-text"></code></pre>
        </div>

        <div class="script-row">
          <span>Generator</span>
          <code id="script-path">{generatorScriptPath}</code>
          <button class="copy-button compact" type="button" data-copy-target="script-path">Copy</button>
        </div>

        <div class="script-row">
          <span>Server</span>
          <code id="server-script-path">{serverScriptPath}</code>
          <button class="copy-button compact" type="button" data-copy-target="server-script-path">Copy</button>
        </div>
      </section>

      <section class="prereq-panel" aria-label="Prerequisites and browser access">
        <div>
          <span class="panel-kicker">Prerequisites</span>
          <h2>Local Tools</h2>
          <ul>
            <li><code>python3</code> for the companion server and generator script.</li>
            <li><code>edge-tts</code> for spoken numbers.</li>
            <li><code>ffmpeg</code> and <code>ffprobe</code> for rendering, timing, and muxing.</li>
          </ul>
          <pre><code>python3 -m pip install edge-tts
ffmpeg -version
ffprobe -version</code></pre>
        </div>

        <div>
          <span class="panel-kicker">Browser Access</span>
          <h2>Localhost API</h2>
          <p>
            The companion server binds to <code>{defaultServerUrl}</code> by default and returns
            CORS plus private-network headers for browser requests from the static page.
            If you run it on another port, update the server field above.
          </p>
        </div>
      </section>
    </section>
  </main>
</BaseLayout>

<style>
  :global(body) {
    background: #05070b;
  }

  .ascii-page {
    min-height: 100vh;
    padding: 6rem 1.25rem 3rem;
    background:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(145deg, #05070b 0%, #101522 48%, #07080d 100%);
    background-size: 28px 28px, 28px 28px, auto;
  }

  .hero,
  .forge-bench {
    width: min(1120px, 100%);
    margin: 0 auto;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(360px, 1fr);
    gap: 1.5rem;
    align-items: stretch;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 420px;
    padding: 2rem 0;
  }

  .eyebrow,
  .panel-kicker {
    color: #7ee8ff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1,
  h2,
  p {
    margin: 0;
  }

  h1 {
    margin-top: 0.75rem;
    color: #f6fbff;
    font-size: 3.7rem;
    line-height: 0.95;
    letter-spacing: 0;
    text-shadow:
      0 0 20px rgba(126, 232, 255, 0.22),
      0 0 46px rgba(255, 70, 188, 0.14);
  }

  .hero-copy p {
    max-width: 34rem;
    margin-top: 1.1rem;
    color: #aab6c8;
    font-size: 1.03rem;
    line-height: 1.7;
  }

  .preview-shell {
    position: relative;
    min-height: 420px;
    overflow: hidden;
    border: 1px solid rgba(126, 232, 255, 0.24);
    border-radius: 8px;
    background: #03050a;
    box-shadow:
      0 0 0 1px rgba(255, 70, 188, 0.08),
      0 24px 80px rgba(0, 0, 0, 0.35),
      inset 0 0 42px rgba(126, 232, 255, 0.08);
  }

  .preview-shell::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.18) 0 1px, transparent 1px 4px),
      linear-gradient(90deg, rgba(255, 70, 188, 0.08), transparent 18%, transparent 82%, rgba(126, 232, 255, 0.1));
    mix-blend-mode: screen;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .forge-bench {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .render-panel,
  .status-panel,
  .result-panel,
  .command-panel,
  .prereq-panel {
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 8px;
    background: rgba(9, 12, 18, 0.9);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .render-panel,
  .status-panel,
  .result-panel,
  .command-panel,
  .prereq-panel {
    padding: 1.2rem;
  }

  .render-panel,
  .status-panel,
  .command-panel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .result-panel,
  .command-panel,
  .prereq-panel {
    grid-column: 1 / -1;
  }

  .result-panel[hidden] {
    display: none;
  }

  .prereq-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.2rem;
  }

  .field-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .panel-heading,
  .command-heading,
  .action-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .command-heading,
  .action-row {
    align-items: center;
  }

  .command-heading {
    color: #c7d2e2;
    font-size: 0.86rem;
    font-weight: 700;
  }

  h2 {
    margin-top: 0.25rem;
    color: #eef6ff;
    font-size: 1.25rem;
    letter-spacing: 0;
  }

  label {
    display: grid;
    gap: 0.45rem;
    color: #c7d2e2;
    font-size: 0.9rem;
    font-weight: 600;
  }

  input {
    width: 100%;
    min-width: 0;
    border: 1px solid rgba(126, 232, 255, 0.22);
    border-radius: 6px;
    background: #050811;
    color: #f6fbff;
    font: inherit;
    font-size: 1rem;
    padding: 0.72rem 0.8rem;
    outline: none;
  }

  input:focus {
    border-color: #7ee8ff;
    box-shadow: 0 0 0 3px rgba(126, 232, 255, 0.12);
  }

  .helper-text,
  .status-text,
  .prereq-panel li,
  .prereq-panel p {
    color: #93a1b7;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .primary-button,
  .download-button,
  .copy-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.38rem;
    min-height: 2.4rem;
    border-radius: 6px;
    font: inherit;
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.18s, border-color 0.18s, color 0.18s, opacity 0.18s;
  }

  .primary-button,
  .download-button {
    border: 1px solid rgba(255, 223, 126, 0.42);
    background: #ffdf7e;
    color: #12151a;
    padding: 0.66rem 0.9rem;
  }

  .primary-button:hover,
  .download-button:hover {
    border-color: #fff1a8;
    background: #fff1a8;
  }

  .primary-button:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .copy-button {
    border: 1px solid rgba(126, 232, 255, 0.28);
    background: rgba(126, 232, 255, 0.08);
    color: #dff9ff;
    padding: 0.52rem 0.72rem;
  }

  .copy-button:hover,
  .copy-button.copied {
    border-color: #7ee8ff;
    background: rgba(126, 232, 255, 0.16);
    color: #ffffff;
  }

  .copy-button.compact {
    min-height: 2rem;
    padding: 0.34rem 0.55rem;
    font-size: 0.78rem;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    min-height: 1.85rem;
    border: 1px solid rgba(147, 161, 183, 0.28);
    border-radius: 999px;
    color: #c7d2e2;
    background: rgba(147, 161, 183, 0.08);
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.22rem 0.62rem;
    text-transform: uppercase;
  }

  .status-pill.running {
    border-color: rgba(126, 232, 255, 0.4);
    background: rgba(126, 232, 255, 0.12);
    color: #dff9ff;
  }

  .status-pill.complete {
    border-color: rgba(126, 255, 171, 0.42);
    background: rgba(126, 255, 171, 0.1);
    color: #d9ffe8;
  }

  .status-pill.failed,
  .status-pill.offline {
    border-color: rgba(255, 101, 126, 0.45);
    background: rgba(255, 101, 126, 0.1);
    color: #ffd9df;
  }

  .progress-track {
    height: 0.62rem;
    overflow: hidden;
    border: 1px solid rgba(126, 232, 255, 0.16);
    border-radius: 999px;
    background: #03050a;
  }

  .progress-bar {
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #7ee8ff, #ff46bc, #ffdf7e);
    transition: width 0.24s ease;
  }

  pre {
    overflow-x: auto;
    margin: 0;
    padding: 1rem;
    border: 1px solid rgba(255, 70, 188, 0.22);
    border-radius: 8px;
    background: #03050a;
    color: #e8fbff;
    box-shadow: inset 0 0 30px rgba(126, 232, 255, 0.05);
  }

  .log-box {
    min-height: 9rem;
    max-height: 15rem;
  }

  code {
    font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
  }

  pre code {
    font-size: 0.88rem;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .script-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    color: #93a1b7;
    font-size: 0.86rem;
  }

  .script-row code {
    color: #ffdf7e;
  }

  video {
    display: block;
    width: 100%;
    max-height: 78vh;
    margin-top: 1rem;
    border: 1px solid rgba(126, 232, 255, 0.2);
    border-radius: 8px;
    background: #03050a;
  }

  ul {
    margin: 1rem 0;
    padding-left: 1.15rem;
  }

  li + li {
    margin-top: 0.45rem;
  }

  @media (max-width: 860px) {
    .ascii-page {
      padding-top: 5rem;
    }

    .hero,
    .forge-bench,
    .prereq-panel {
      grid-template-columns: 1fr;
    }

    .hero-copy,
    .preview-shell {
      min-height: 320px;
    }

    h1 {
      font-size: 2.55rem;
    }
  }

  @media (max-width: 520px) {
    .ascii-page {
      padding-inline: 0.85rem;
    }

    .hero-copy,
    .preview-shell {
      min-height: 280px;
    }

    .field-grid,
    .panel-heading,
    .command-heading,
    .action-row {
      grid-template-columns: 1fr;
      align-items: stretch;
      flex-direction: column;
    }

    h1 {
      font-size: 2.1rem;
    }
