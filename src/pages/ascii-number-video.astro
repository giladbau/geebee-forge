</style>

<script is:inline>
  // @ts-nocheck
  const generatorScriptPath = 'scripts/generate_ascii_number_video.py';
  const serverScriptPath = 'scripts/ascii_number_video_server.py';
  const defaultServerUrl = 'http://127.0.0.1:8765';

  const widthInput = document.getElementById('width-input');
  const heightInput = document.getElementById('height-input');
  const serverUrlInput = document.getElementById('server-url-input');
  const renderForm = document.getElementById('render-form');
  const generateButton = document.getElementById('generate-button');
  const refreshButton = document.getElementById('refresh-button');
  const commandText = document.getElementById('command-text');
  const statusHeading = document.getElementById('status-heading');
  const statusPill = document.getElementById('status-pill');
  const statusText = document.getElementById('status-text');
  const progressBar = document.getElementById('progress-bar');
  const logText = document.getElementById('log-text');
  const resultPanel = document.getElementById('result-panel');
  const resultVideo = document.getElementById('result-video');
  const downloadLink = document.getElementById('download-link');
  const preview = document.getElementById('ascii-preview');
  const ctx = preview.getContext('2d');

  const digitSegments = {
    0: 'abcdef',
    1: 'bc',
    2: 'abged',
    3: 'abgcd',
    4: 'fgbc',
    5: 'afgcd',
    6: 'afgecd',
    7: 'abc',
    8: 'abcdefg',
    9: 'abfgcd',
  };
  const glyphs = '@#%&*+=:.';
  const digitWidth = 13;
  const digitHeight = 21;
  const digitGap = 3;
  const pollIntervalMs = 1800;

  let currentJobId = null;
  let pollTimer = null;

  function clamp(value, min, max, fallback) {
    const parsed = Number.parseInt(value, 10);
    if (Number.isNaN(parsed)) return fallback;
    return Math.min(max, Math.max(min, parsed));
  }

  function evenClamp(value, min, max, fallback) {
    let parsed = clamp(value, min, max, fallback);
    if (parsed % 2 !== 0) {
      parsed = parsed < max ? parsed + 1 : parsed - 1;
    }
    return parsed;
  }

  function shellToken(value) {
    return /^[A-Za-z0-9._/-]+$/.test(value) ? value : `'${value.replaceAll("'", "'\\''")}'`;
  }

  function currentDimensions() {
    return {
      width: evenClamp(widthInput.value, 320, 7680, 1080),
      height: evenClamp(heightInput.value, 180, 4320, 1920),
    };
  }

  function updateCommand() {
    const { width, height } = currentDimensions();
    const output = `ascii-numbers-${width}x${height}.mp4`;
    commandText.textContent = `python3 ${generatorScriptPath} --width ${width} --height ${height} --output ${shellToken(output)}`;
  }

  function syncDimensionInputs() {
    const { width, height } = currentDimensions();
    widthInput.value = String(width);
    heightInput.value = String(height);
    updateCommand();
    return { width, height };
  }

  function companionBaseUrl() {
    const raw = serverUrlInput.value.trim() || defaultServerUrl;
    const url = new URL(raw);
    if (!['http:', 'https:'].includes(url.protocol)) {
      throw new Error('Server URL must start with http:// or https://.');
    }
    url.pathname = url.pathname.replace(/\/+$/, '');
    url.search = '';
    url.hash = '';
    return url.toString().replace(/\/$/, '');
  }

  function companionUrl(path) {
    return `${companionBaseUrl()}${path}`;
  }

  async function requestJson(path, options = {}) {
    const headers = {
      ...(options.headers || {}),
    };
    if (options.body) {
      headers['Content-Type'] = 'application/json';
    }
    const response = await fetch(companionUrl(path), {
      ...options,
      headers,
    });
    const text = await response.text();
    let payload = {};
    if (text) {
      try {
        payload = JSON.parse(text);
      } catch {
        payload = { error: text };
      }
    }
    if (!response.ok) {
      const message = payload.error || `Request failed with HTTP ${response.status}`;
      const error = new Error(message);
      error.status = response.status;
      error.payload = payload;
      throw error;
    }
    return payload;
  }

  function setStatus({ heading, pill, text, progress = 0, tone = '' }) {
    statusHeading.textContent = heading;
    statusPill.textContent = pill;
    statusPill.className = `status-pill ${tone}`.trim();
    statusText.textContent = text;
    progressBar.style.width = `${Math.max(0, Math.min(100, progress))}%`;
  }

  function setLogs(lines) {
    if (!Array.isArray(lines) || lines.length === 0) {
      logText.textContent = 'No render log yet.';
      return;
    }
    logText.textContent = lines.slice(-80).join('\n');
  }

  function showResult(job) {
    if (job.status !== 'complete' || !job.video_url || !job.download_url) {
      resultPanel.hidden = true;
      return;
    }
    const videoUrl = companionUrl(job.video_url);
    const downloadUrl = companionUrl(job.download_url);
    if (resultVideo.dataset.jobId !== job.job_id) {
      resultVideo.src = `${videoUrl}?t=${Date.now()}`;
      resultVideo.dataset.jobId = job.job_id;
    }
    downloadLink.href = downloadUrl;
    downloadLink.download = job.output_name || 'ascii-number-video.mp4';
    resultPanel.hidden = false;
  }

  function renderJob(job) {
    if (!job || job.status === 'idle') {
      currentJobId = null;
      generateButton.disabled = false;
      setStatus({
        heading: 'Ready',
        pill: 'Idle',
        text: 'The companion server is reachable and ready for a render.',
        progress: 0,
      });
      setLogs([]);
      resultPanel.hidden = true;
      return;
    }

    currentJobId = job.job_id || currentJobId;
    setLogs(job.logs);
    showResult(job);

    if (job.status === 'queued' || job.status === 'running') {
      generateButton.disabled = true;
      setStatus({
        heading: job.phase || 'Rendering',
        pill: 'Running',
        text: `Rendering ${job.width}x${job.height}. Keep the companion server running until this completes.`,
        progress: job.progress || 5,
        tone: 'running',
      });
      schedulePoll();
      return;
    }

    generateButton.disabled = false;
    if (job.status === 'complete') {
      setStatus({
        heading: 'Complete',
        pill: 'Ready',
        text: `Generated ${job.output_name}. Preview it below or download the MP4.`,
        progress: 100,
        tone: 'complete',
      });
      stopPolling();
      return;
    }

    setStatus({
      heading: 'Render Failed',
      pill: 'Failed',
      text: job.error || 'The generator failed. Check the render log and local prerequisites.',
      progress: job.progress || 0,
      tone: 'failed',
    });
    stopPolling();
  }

  function renderOffline(error) {
    generateButton.disabled = false;
    stopPolling();
    setStatus({
      heading: 'Server Offline',
      pill: 'Offline',
      text: `${error.message} Start ${serverScriptPath} locally, then refresh status.`,
      progress: 0,
      tone: 'offline',
    });
    setLogs([]);
    resultPanel.hidden = true;
  }

  function renderRequestError(error) {
    generateButton.disabled = false;
    stopPolling();
    setStatus({
      heading: 'Request Rejected',
      pill: 'Failed',
      text: error.message || 'The companion server rejected the request.',
      progress: 0,
      tone: 'failed',
    });
    setLogs([error.message || 'Request failed.']);
    resultPanel.hidden = true;
  }

  function stopPolling() {
    if (pollTimer) {
      window.clearTimeout(pollTimer);
      pollTimer = null;
    }
  }

  function schedulePoll() {
    stopPolling();
    pollTimer = window.setTimeout(pollStatus, pollIntervalMs);
  }

  async function pollStatus() {
    try {
      const path = currentJobId ? `/jobs/${currentJobId}` : '/status';
      const job = await requestJson(path, { method: 'GET', headers: {} });
      renderJob(job);
    } catch (error) {
      renderOffline(error);
    }
  }

  async function startGenerate(event) {
    event.preventDefault();
    const { width, height } = syncDimensionInputs();
    stopPolling();
    resultPanel.hidden = true;
    setStatus({
      heading: 'Starting Render',
      pill: 'Starting',
      text: 'Sending the render request to the local companion server.',
      progress: 2,
      tone: 'running',
    });
    setLogs(['Submitting render request...']);

    try {
      const job = await requestJson('/generate', {
        method: 'POST',
        body: JSON.stringify({ width, height }),
      });
      currentJobId = job.job_id;
      renderJob(job);
      schedulePoll();
    } catch (error) {
      if (error.status === 409 && error.payload?.active_job) {
        currentJobId = error.payload.active_job.job_id;
        renderJob(error.payload.active_job);
        schedulePoll();
        return;
      }
      if (error.status) {
        renderRequestError(error);
        return;
      }
      renderOffline(error);
    }
  }

  function cellsForSegment(segment) {
    const cells = [];
    const pushRect = (x0, x1, y0, y1) => {
      for (let y = y0; y < y1; y += 1) {
        for (let x = x0; x < x1; x += 1) {
          cells.push([x, y]);
        }
      }
    };
    if (segment === 'a') pushRect(2, 11, 0, 3);
    if (segment === 'b') pushRect(10, 13, 2, 10);
    if (segment === 'c') pushRect(10, 13, 11, 19);
    if (segment === 'd') pushRect(2, 11, 18, 21);
    if (segment === 'e') pushRect(0, 3, 11, 19);
    if (segment === 'f') pushRect(0, 3, 2, 10);
    if (segment === 'g') pushRect(2, 11, 9, 12);
    return cells;
  }

  function numberCells(number) {
    const cells = new Map();
    let offset = 0;
    String(number).split('').forEach((digit) => {
      digitSegments[digit].split('').forEach((segment) => {
        cellsForSegment(segment).forEach(([x, y]) => {
          cells.set(`${x + offset},${y}`, [x + offset, y]);
        });
      });
      offset += digitWidth + digitGap;
    });
    return { cells: Array.from(cells.values()), columns: offset - digitGap };
  }

  function drawPreview() {
    const width = preview.width;
    const height = preview.height;
    const now = performance.now();
    const number = (Math.floor(now / 1000) % 60) + 1;
    const { cells, columns } = numberCells(number);
    const single = number < 10;
    const cellW = Math.max(10, Math.floor((width * (single ? 0.68 : 0.86)) / columns));
    const cellH = Math.max(12, Math.floor((height * 0.78) / digitHeight));
    const gridW = columns * cellW;
    const gridH = digitHeight * cellH;
    const ox = (width - gridW) / 2;
    const oy = (height - gridH) / 2;

    const bg = ctx.createLinearGradient(0, 0, width, height);
    bg.addColorStop(0, '#05070b');
    bg.addColorStop(0.48, '#101522');
    bg.addColorStop(1, '#05070b');
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, width, height);

    ctx.save();
    ctx.globalAlpha = 0.24;
    ctx.strokeStyle = '#7ee8ff';
    for (let x = 0; x < width; x += 32) {
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, height);
      ctx.stroke();
    }
    for (let y = 0; y < height; y += 32) {
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(width, y);
      ctx.stroke();
    }
    ctx.restore();

    cells.forEach(([cellX, cellY], index) => {
      const x = ox + cellX * cellW;
      const y = oy + cellY * cellH;
      const hue = 188 + ((cellX / columns) * 96 + Math.sin(now / 520 + cellY) * 24);
      const color = `hsl(${hue}, 100%, 68%)`;
      ctx.shadowBlur = 22;
      ctx.shadowColor = color;
      ctx.fillStyle = color;
      ctx.globalAlpha = 0.16;
      ctx.fillRect(x - cellW * 0.35, y - cellH * 0.35, cellW * 1.7, cellH * 1.7);
      ctx.globalAlpha = 1;
      ctx.font = `${Math.max(12, Math.floor(cellH * 0.8))}px monospace`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(glyphs[(index + number + cellY) % glyphs.length], x + cellW / 2, y + cellH / 2);
    });

    ctx.globalAlpha = 0.18;
    ctx.fillStyle = '#000';
    for (let y = 0; y < height; y += 4) {
      ctx.fillRect(0, y, width, 1);
    }
    ctx.globalAlpha = 1;
    ctx.shadowBlur = 0;
    requestAnimationFrame(drawPreview);
  }

  async function copyTarget(targetId, button) {
    const target = document.getElementById(targetId);
    const text = target?.textContent?.trim();
    if (!text) return;
    await navigator.clipboard.writeText(text);
    button.classList.add('copied');
    const previous = button.textContent;
    button.textContent = 'Copied';
    window.setTimeout(() => {
      button.classList.remove('copied');
      button.textContent = previous;
    }, 1200);
  }

  widthInput.addEventListener('input', updateCommand);
  heightInput.addEventListener('input', updateCommand);
  widthInput.addEventListener('blur', syncDimensionInputs);
  heightInput.addEventListener('blur', syncDimensionInputs);
  renderForm.addEventListener('submit', startGenerate);
  refreshButton.addEventListener('click', pollStatus);
  serverUrlInput.addEventListener('change', () => {
    currentJobId = null;
    pollStatus();
  });
  document.querySelectorAll('[data-copy-target]').forEach((button) => {
    button.addEventListener('click', () => copyTarget(button.dataset.copyTarget, button));
  });

  updateCommand();
  drawPreview();
  pollStatus();
</script>
