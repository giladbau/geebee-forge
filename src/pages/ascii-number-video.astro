---
import BaseLayout from '../layouts/BaseLayout.astro';

const scriptPath = 'scripts/generate_ascii_number_video.py';
---

<BaseLayout title="ASCII Number Video | GeeBee Forge">
  <main class="ascii-page">
    <section class="hero" aria-labelledby="page-title">
      <div class="hero-copy">
        <span class="eyebrow">Local Forge Tool</span>
        <h1 id="page-title">ASCII Number Video</h1>
        <p>
          Generate a one-minute MP4 where neon ASCII-styled numbers count from 1 to 60,
          one number per second, with every number spoken by edge-tts.
        </p>
      </div>

      <div class="preview-shell" aria-label="Animated preview of ASCII number style">
        <canvas id="ascii-preview" width="960" height="540"></canvas>
      </div>
    </section>

    <section class="forge-bench" aria-label="Generator command builder">
      <form class="control-panel" aria-label="Video dimensions">
        <div>
          <span class="panel-kicker">Dimensions</span>
          <h2>Build Command</h2>
        </div>

        <label>
          <span>Width</span>
          <input id="width-input" type="number" min="320" max="7680" step="2" value="1080" inputmode="numeric" />
        </label>

        <label>
          <span>Height</span>
          <input id="height-input" type="number" min="180" max="4320" step="2" value="1920" inputmode="numeric" />
        </label>

        <p>
          This static page only prepares the command and preview. Run the script locally so
          Python, edge-tts, and ffmpeg can create the video on your machine.
        </p>
      </form>

      <div class="command-panel">
        <div class="panel-heading">
          <div>
            <span class="panel-kicker">Exact Local Command</span>
            <h2>Render MP4</h2>
          </div>
          <button class="copy-button" type="button" data-copy-target="command-text" aria-label="Copy render command" title="Copy render command">
            <span aria-hidden="true">⧉</span>
            <span>Copy</span>
          </button>
        </div>

        <pre><code id="command-text"></code></pre>

        <div class="script-row">
          <span>Script</span>
          <code id="script-path">{scriptPath}</code>
          <button class="copy-button compact" type="button" data-copy-target="script-path" aria-label="Copy script path" title="Copy script path">
            <span aria-hidden="true">⧉</span>
            <span>Copy</span>
          </button>
        </div>
      </div>

      <div class="prereq-panel">
        <span class="panel-kicker">Prerequisites</span>
        <h2>Local Tools</h2>
        <ul>
          <li><code>python3</code> for the reusable generator script.</li>
          <li><code>edge-tts</code> for spoken numbers.</li>
          <li><code>ffmpeg</code> and <code>ffprobe</code> for rendering, timing, and muxing.</li>
        </ul>
        <pre><code>python3 -m pip install edge-tts
ffmpeg -version
ffprobe -version</code></pre>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  :global(body) {
    background: #05070b;
  }

  .ascii-page {
    min-height: 100vh;
    padding: 6rem 1.25rem 3rem;
    background:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(145deg, #05070b 0%, #101522 48%, #07080d 100%);
    background-size: 28px 28px, 28px 28px, auto;
  }

  .hero,
  .forge-bench {
    width: min(1120px, 100%);
    margin: 0 auto;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(360px, 1fr);
    gap: 1.5rem;
    align-items: stretch;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 420px;
    padding: 2rem 0;
  }

  .eyebrow,
  .panel-kicker {
    color: #7ee8ff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1,
  h2,
  p {
    margin: 0;
  }

  h1 {
    margin-top: 0.75rem;
    color: #f6fbff;
    font-size: 3.7rem;
    line-height: 0.95;
    letter-spacing: 0;
    text-shadow:
      0 0 20px rgba(126, 232, 255, 0.22),
      0 0 46px rgba(255, 70, 188, 0.14);
  }

  .hero-copy p {
    max-width: 34rem;
    margin-top: 1.1rem;
    color: #aab6c8;
    font-size: 1.03rem;
    line-height: 1.7;
  }

  .preview-shell {
    position: relative;
    min-height: 420px;
    overflow: hidden;
    border: 1px solid rgba(126, 232, 255, 0.24);
    border-radius: 8px;
    background: #03050a;
    box-shadow:
      0 0 0 1px rgba(255, 70, 188, 0.08),
      0 24px 80px rgba(0, 0, 0, 0.35),
      inset 0 0 42px rgba(126, 232, 255, 0.08);
  }

  .preview-shell::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.18) 0 1px, transparent 1px 4px),
      linear-gradient(90deg, rgba(255, 70, 188, 0.08), transparent 18%, transparent 82%, rgba(126, 232, 255, 0.1));
    mix-blend-mode: screen;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .forge-bench {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .control-panel,
  .command-panel,
  .prereq-panel {
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 8px;
    background: rgba(9, 12, 18, 0.88);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .control-panel {
    display: grid;
    gap: 1rem;
    padding: 1.2rem;
  }

  .command-panel,
  .prereq-panel {
    padding: 1.2rem;
  }

  .command-panel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .prereq-panel {
    grid-column: 1 / -1;
  }

  .panel-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  h2 {
    margin-top: 0.25rem;
    color: #eef6ff;
    font-size: 1.25rem;
    letter-spacing: 0;
  }

  label {
    display: grid;
    gap: 0.45rem;
    color: #c7d2e2;
    font-size: 0.9rem;
    font-weight: 600;
  }

  input {
    width: 100%;
    border: 1px solid rgba(126, 232, 255, 0.22);
    border-radius: 6px;
    background: #050811;
    color: #f6fbff;
    font: inherit;
    font-size: 1rem;
    padding: 0.72rem 0.8rem;
    outline: none;
  }

  input:focus {
    border-color: #7ee8ff;
    box-shadow: 0 0 0 3px rgba(126, 232, 255, 0.12);
  }

  .control-panel p,
  .prereq-panel li {
    color: #93a1b7;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  pre {
    overflow-x: auto;
    margin: 0;
    padding: 1rem;
    border: 1px solid rgba(255, 70, 188, 0.22);
    border-radius: 8px;
    background: #03050a;
    color: #e8fbff;
    box-shadow: inset 0 0 30px rgba(126, 232, 255, 0.05);
  }

  code {
    font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
  }

  pre code {
    font-size: 0.88rem;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .copy-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.38rem;
    border: 1px solid rgba(126, 232, 255, 0.28);
    border-radius: 6px;
    background: rgba(126, 232, 255, 0.08);
    color: #dff9ff;
    font: inherit;
    font-size: 0.86rem;
    font-weight: 700;
    padding: 0.52rem 0.72rem;
    cursor: pointer;
    transition: background 0.18s, border-color 0.18s, color 0.18s;
  }

  .copy-button:hover,
  .copy-button.copied {
    border-color: #7ee8ff;
    background: rgba(126, 232, 255, 0.16);
    color: #ffffff;
  }

  .copy-button.compact {
    padding: 0.38rem 0.55rem;
    font-size: 0.78rem;
  }

  .script-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    color: #93a1b7;
    font-size: 0.86rem;
  }

  .script-row code {
    color: #ffdf7e;
  }

  ul {
    margin: 1rem 0;
    padding-left: 1.15rem;
  }

  li + li {
    margin-top: 0.45rem;
  }

  @media (max-width: 860px) {
    .ascii-page {
      padding-top: 5rem;
    }

    .hero,
    .forge-bench {
      grid-template-columns: 1fr;
    }

    .hero-copy,
    .preview-shell {
      min-height: 320px;
    }

    h1 {
      font-size: 2.55rem;
    }
  }

  @media (max-width: 520px) {
    .ascii-page {
      padding-inline: 0.85rem;
    }

    .hero-copy,
    .preview-shell {
      min-height: 280px;
    }

    h1 {
      font-size: 2.1rem;
    }

    .panel-heading {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>

<script is:inline>
  // @ts-nocheck
  const scriptPath = 'scripts/generate_ascii_number_video.py';
  const widthInput = document.getElementById('width-input');
  const heightInput = document.getElementById('height-input');
  const commandText = document.getElementById('command-text');
  const preview = document.getElementById('ascii-preview');
  const ctx = preview.getContext('2d');

  const digitSegments = {
    0: 'abcdef',
    1: 'bc',
    2: 'abged',
    3: 'abgcd',
    4: 'fgbc',
    5: 'afgcd',
    6: 'afgecd',
    7: 'abc',
    8: 'abcdefg',
    9: 'abfgcd',
  };
  const glyphs = '@#%&*+=:.';
  const digitWidth = 13;
  const digitHeight = 21;
  const digitGap = 3;

  function clamp(value, min, max, fallback) {
    const parsed = Number.parseInt(value, 10);
    if (Number.isNaN(parsed)) return fallback;
    return Math.min(max, Math.max(min, parsed));
  }

  function shellToken(value) {
    return /^[A-Za-z0-9._/-]+$/.test(value) ? value : `'${value.replaceAll("'", "'\\''")}'`;
  }

  function currentDimensions() {
    return {
      width: clamp(widthInput.value, 320, 7680, 1080),
      height: clamp(heightInput.value, 180, 4320, 1920),
    };
  }

  function updateCommand() {
    const { width, height } = currentDimensions();
    const output = `ascii-numbers-${width}x${height}.mp4`;
    commandText.textContent = `python3 ${scriptPath} --width ${width} --height ${height} --output ${shellToken(output)}`;
  }

  function cellsForSegment(segment) {
    const cells = [];
    const pushRect = (x0, x1, y0, y1) => {
      for (let y = y0; y < y1; y += 1) {
        for (let x = x0; x < x1; x += 1) {
          cells.push([x, y]);
        }
      }
    };
    if (segment === 'a') pushRect(2, 11, 0, 3);
    if (segment === 'b') pushRect(10, 13, 2, 10);
    if (segment === 'c') pushRect(10, 13, 11, 19);
    if (segment === 'd') pushRect(2, 11, 18, 21);
    if (segment === 'e') pushRect(0, 3, 11, 19);
    if (segment === 'f') pushRect(0, 3, 2, 10);
    if (segment === 'g') pushRect(2, 11, 9, 12);
    return cells;
  }

  function numberCells(number) {
    const cells = new Map();
    let offset = 0;
    String(number).split('').forEach((digit) => {
      digitSegments[digit].split('').forEach((segment) => {
        cellsForSegment(segment).forEach(([x, y]) => {
          cells.set(`${x + offset},${y}`, [x + offset, y]);
        });
      });
      offset += digitWidth + digitGap;
    });
    return { cells: Array.from(cells.values()), columns: offset - digitGap };
  }

  function drawPreview() {
    const width = preview.width;
    const height = preview.height;
    const now = performance.now();
    const number = (Math.floor(now / 1000) % 60) + 1;
    const { cells, columns } = numberCells(number);
    const single = number < 10;
    const cellW = Math.max(10, Math.floor((width * (single ? 0.68 : 0.86)) / columns));
    const cellH = Math.max(12, Math.floor((height * 0.78) / digitHeight));
    const gridW = columns * cellW;
    const gridH = digitHeight * cellH;
    const ox = (width - gridW) / 2;
    const oy = (height - gridH) / 2;

    const bg = ctx.createLinearGradient(0, 0, width, height);
    bg.addColorStop(0, '#05070b');
    bg.addColorStop(0.48, '#101522');
    bg.addColorStop(1, '#05070b');
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, width, height);

    ctx.save();
    ctx.globalAlpha = 0.24;
    ctx.strokeStyle = '#7ee8ff';
    for (let x = 0; x < width; x += 32) {
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, height);
      ctx.stroke();
    }
    for (let y = 0; y < height; y += 32) {
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(width, y);
      ctx.stroke();
    }
    ctx.restore();

    cells.forEach(([cellX, cellY], index) => {
      const x = ox + cellX * cellW;
      const y = oy + cellY * cellH;
      const hue = 188 + ((cellX / columns) * 96 + Math.sin(now / 520 + cellY) * 24);
      const color = `hsl(${hue}, 100%, 68%)`;
      ctx.shadowBlur = 22;
      ctx.shadowColor = color;
      ctx.fillStyle = color;
      ctx.globalAlpha = 0.16;
      ctx.fillRect(x - cellW * 0.35, y - cellH * 0.35, cellW * 1.7, cellH * 1.7);
      ctx.globalAlpha = 1;
      ctx.font = `${Math.max(12, Math.floor(cellH * 0.8))}px monospace`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(glyphs[(index + number + cellY) % glyphs.length], x + cellW / 2, y + cellH / 2);
    });

    ctx.globalAlpha = 0.18;
    ctx.fillStyle = '#000';
    for (let y = 0; y < height; y += 4) {
      ctx.fillRect(0, y, width, 1);
    }
    ctx.globalAlpha = 1;
    ctx.shadowBlur = 0;
    requestAnimationFrame(drawPreview);
  }

  async function copyTarget(targetId, button) {
    const target = document.getElementById(targetId);
    const text = target?.textContent?.trim();
    if (!text) return;
    await navigator.clipboard.writeText(text);
    button.classList.add('copied');
    const label = button.querySelector('span:last-child');
    const previous = label.textContent;
    label.textContent = 'Copied';
    window.setTimeout(() => {
      button.classList.remove('copied');
      label.textContent = previous;
    }, 1200);
  }

  widthInput.addEventListener('input', updateCommand);
  heightInput.addEventListener('input', updateCommand);
  document.querySelectorAll('[data-copy-target]').forEach((button) => {
    button.addEventListener('click', () => copyTarget(button.dataset.copyTarget, button));
  });

  updateCommand();
  drawPreview();
</script>
