---
import { execSync } from 'node:child_process';
const buildVersion = process.env.CF_PAGES_COMMIT_SHA || process.env.GITHUB_SHA || execSync('git rev-parse HEAD', {encoding:'utf8'}).trim();
import BaseLayout from '../layouts/BaseLayout.astro';
import ShapeSudokuLab from '../components/svelte/shape-sudoku-lab/ShapeSudokuLab.svelte';
---
<BaseLayout title="Shape Sudoku Recognizer Lab | GeeBee Forge">
	<ShapeSudokuLab client:only="svelte" buildVersion={buildVersion} />
</BaseLayout>
